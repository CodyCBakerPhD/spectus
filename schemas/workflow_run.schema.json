{
    "$defs": {
        "RunConclusion": {
            "description": "",
            "enum": [
                "action_required",
                "cancelled",
                "failure",
                "neutral",
                "skipped",
                "stale",
                "startup_failure",
                "success",
                "timed_out"
            ],
            "title": "RunConclusion",
            "type": "string"
        },
        "RunStatus": {
            "description": "",
            "enum": [
                "requested",
                "queued",
                "pending",
                "waiting",
                "in_progress",
                "completed"
            ],
            "title": "RunStatus",
            "type": "string"
        },
        "WorkflowRun": {
            "additionalProperties": false,
            "description": "The state of one workflow run when it was observed. A run that is re-run after it was recorded is recorded again, with its new state.",
            "properties": {
                "actor": {
                    "description": "The login of the user who triggered the run.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "completed_at": {
                    "description": "When the last job of the latest attempt of the run completed.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "conclusion": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/RunConclusion"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The outcome of the run; null until the run has completed."
                },
                "created_at": {
                    "description": "When the run was created.",
                    "format": "date-time",
                    "type": "string"
                },
                "duration_seconds": {
                    "description": "The whole seconds from `started_at` to `completed_at`.",
                    "minimum": 0,
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "event": {
                    "description": "The event that triggered the run, such as `push`, `pull_request`, or `schedule`.",
                    "type": "string"
                },
                "head_branch": {
                    "description": "The branch the run ran on; null once that branch no longer exists.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "head_sha": {
                    "description": "The commit the run ran on.",
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                },
                "id": {
                    "description": "The database ID of the run, unique across GitHub.",
                    "minimum": 1,
                    "type": "integer"
                },
                "repository": {
                    "description": "The repository the run belongs to, as `owner/name`.",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}/[A-Za-z0-9._-]{1,100}$",
                    "type": "string"
                },
                "run_number": {
                    "description": "The number of the run within its workflow.",
                    "minimum": 1,
                    "type": "integer"
                },
                "started_at": {
                    "description": "When the first job of the latest attempt of the run started.",
                    "format": "date-time",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "status": {
                    "$ref": "#/$defs/RunStatus",
                    "description": "The status of the run when it was observed."
                },
                "updated_at": {
                    "description": "When the run was last updated before it was observed.",
                    "format": "date-time",
                    "type": "string"
                },
                "url": {
                    "description": "The web page of the run.",
                    "format": "uri",
                    "type": "string"
                },
                "workflow_name": {
                    "description": "The name of the workflow that ran.",
                    "type": "string"
                },
                "workflow_path": {
                    "description": "The path of the workflow file within its repository, such as `.github/workflows/tests.yml`.",
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "id",
                "repository",
                "workflow_name",
                "run_number",
                "event",
                "status",
                "created_at",
                "updated_at",
                "head_sha",
                "url"
            ],
            "title": "WorkflowRun",
            "type": "object"
        }
    },
